generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  firstname    String?
  lastname     String?
  email        String        @unique
  password     String?
  image        String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reviews      Review[]
  visits       Visit[]
  reservations Reservation[]
  adClicks     AdClick[]
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  placeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  placeId   String
  placeName String
  visitedAt DateTime @default(now())
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  
  @@index([userId, visitedAt(sort: Desc)])
  @@unique([userId, placeId])
}

model Reservation {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  user          User              @relation(fields: [userId], references: [id])
  placeId       String
  placeName     String
  placeType     PlaceType
  reservationDate DateTime
  timeSlot      String?           // Pour restaurants/attractions (ex: "14:00-16:00")
  roomNumber    String?           // Pour hotels (ex: "101", "Suite Deluxe")
  numberOfGuests Int              @default(1)
  status        ReservationStatus @default(PENDING)
  specialRequests String?
  totalPrice    Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  @@index([placeId, reservationDate])
  @@index([userId, reservationDate(sort: Desc)])
}

enum PlaceType {
  HOTEL
  RESTAURANT
  ATTRACTION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Advertisement {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  imageUrl     String
  targetUrl    String
  advertiser   String
  position     AdPosition
  isActive     Boolean    @default(true)
  budget       Float      @default(0)
  spent        Float      @default(0)
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  cpm          Float      @default(2.5) // Coût par mille impressions
  cpc          Float      @default(0.25) // Coût par clic
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  adClicks     AdClick[]
  
  @@index([position, isActive])
  @@index([startDate, endDate])
}

model AdClick {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  adId        String        @db.ObjectId
  ad          Advertisement @relation(fields: [adId], references: [id])
  userId      String?       @db.ObjectId
  user        User?         @relation(fields: [userId], references: [id])
  ipAddress   String
  userAgent   String
  clickedAt   DateTime      @default(now())
  revenue     Float         @default(0.25)
  
  @@index([adId, clickedAt])
}

model Revenue {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  impressions Int         @default(0)
  clicks      Int         @default(0)
  revenue     Float       @default(0)
  source      RevenueSource
  details     String?
  createdAt   DateTime    @default(now())
  
  @@unique([date, source])
}

enum AdPosition {
  HEADER_BANNER
  SIDEBAR_TOP
  SIDEBAR_BOTTOM
  CONTENT_TOP
  CONTENT_BOTTOM
  MOBILE_BOTTOM
  PLACE_DETAILS
  SEARCH_RESULTS
}

enum RevenueSource {
  ADVERTISEMENTS
  RESERVATIONS
  AFFILIATE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}