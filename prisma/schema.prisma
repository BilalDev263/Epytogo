generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  firstname       String?
  lastname        String?
  email           String              @unique
  password        String?
  image           String?
  role            UserRole            @default(USER)
  subscription    SubscriptionType    @default(FREEMIUM)
  stripeCustomerId String?
  subscriptionId  String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reviews         Review[]
  visits          Visit[]
  reservations    Reservation[]
  adClicks        AdClick[]
  ownedEstablishments Establishment[] @relation("EstablishmentOwner")
  staffEstablishments EstablishmentStaff[]
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  placeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  placeId   String
  placeName String
  visitedAt DateTime @default(now())
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  
  @@index([userId, visitedAt(sort: Desc)])
  @@unique([userId, placeId])
}

model Reservation {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id])
  placeId         String
  placeName       String
  placeType       PlaceType
  establishmentId String?           @db.ObjectId
  establishment   Establishment?    @relation("EstablishmentReservations", fields: [establishmentId], references: [id])
  reservationDate DateTime
  timeSlot        String?           // Pour restaurants/attractions (ex: "14:00-16:00")
  roomNumber      String?           // Pour hotels (ex: "101", "Suite Deluxe")
  numberOfGuests  Int               @default(1)
  status          ReservationStatus @default(PENDING)
  specialRequests String?
  totalPrice      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([placeId, reservationDate])
  @@index([userId, reservationDate(sort: Desc)])
  @@index([establishmentId, reservationDate])
}

model Establishment {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  placeId     String              @unique // ID du lieu dans l'API Google Places
  name        String
  type        PlaceType
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean             @default(true)
  isVerified  Boolean             @default(false)
  ownerId     String              @db.ObjectId
  owner       User                @relation("EstablishmentOwner", fields: [ownerId], references: [id])
  staff       EstablishmentStaff[]
  reservations Reservation[]       @relation("EstablishmentReservations")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type, isActive])
}

model EstablishmentStaff {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id])
  establishmentId String        @db.ObjectId
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  permissions     StaffPermission[]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, establishmentId])
  @@index([establishmentId, isActive])
}

enum PlaceType {
  HOTEL
  RESTAURANT
  ATTRACTION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Advertisement {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  imageUrl     String
  targetUrl    String
  advertiser   String
  position     AdPosition
  isActive     Boolean    @default(true)
  budget       Float      @default(0)
  spent        Float      @default(0)
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  cpm          Float      @default(2.5) // Coût par mille impressions
  cpc          Float      @default(0.25) // Coût par clic
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  adClicks     AdClick[]
  
  @@index([position, isActive])
  @@index([startDate, endDate])
}

model AdClick {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  adId        String        @db.ObjectId
  ad          Advertisement @relation(fields: [adId], references: [id])
  userId      String?       @db.ObjectId
  user        User?         @relation(fields: [userId], references: [id])
  ipAddress   String
  userAgent   String
  clickedAt   DateTime      @default(now())
  revenue     Float         @default(0.25)
  
  @@index([adId, clickedAt])
}

model Revenue {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  impressions Int         @default(0)
  clicks      Int         @default(0)
  revenue     Float       @default(0)
  source      RevenueSource
  details     String?
  createdAt   DateTime    @default(now())
  
  @@unique([date, source])
}

enum AdPosition {
  HEADER_BANNER
  SIDEBAR_TOP
  SIDEBAR_BOTTOM
  CONTENT_TOP
  CONTENT_BOTTOM
  MOBILE_BOTTOM
  PLACE_DETAILS
  SEARCH_RESULTS
}

enum RevenueSource {
  ADVERTISEMENTS
  RESERVATIONS
  AFFILIATE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  RESTAURANT_OWNER
  HOTEL_OWNER
  ATTRACTION_OWNER
  ESTABLISHMENT_STAFF
}

enum StaffPermission {
  VIEW_RESERVATIONS
  MANAGE_RESERVATIONS
  VIEW_ANALYTICS
  MANAGE_ESTABLISHMENT
}

enum SubscriptionType {
  FREEMIUM
  BUSINESS
  ENTERPRISE
  PREMIUM_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}