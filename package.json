{
  "name": "epytogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:performance": "node tests/performance/load-test.js",
    "test:lighthouse": "lhci autorun --config=tests/performance/lighthouse.config.js",
    "test:lighthouse:local": "lhci autorun --config=tests/performance/lighthouse.config.js",
    "test:all": "npm run test && npm run test:integration",
    "test:load": "node scripts/simple-load-test.js",
    "test:load:local": "node scripts/simple-load-test.js http://localhost:3001 10 60",
    "test:load:prod": "node scripts/simple-load-test.js https://your-app.vercel.app 20 120"
  },
  "dependencies": {
    "@googlemaps/react-wrapper": "^1.2.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.55.4",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "check-password-strength": "^2.0.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.2.1",
    "embla-carousel-react": "^8.2.1",
    "lucide-react": "^0.439.0",
    "next": "latest",
    "next-auth": "^4.24.7",
    "prisma": "^5.19.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
